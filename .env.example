# Copy to .env (never commit .env). docker-compose and the backend both read it.

# GitHub personal access token (classic or fine-grained, public read-only access is enough).
GITHUB_TOKEN=

# Postgres credentials used by docker-compose.
POSTGRES_USER=cities
POSTGRES_PASSWORD=cities
POSTGRES_DB=cities

# Used when running the backend directly on your machine (`uv run ...`).
# docker-compose overrides these with in-network hostnames.
DATABASE_URL=postgresql+asyncpg://cities:cities@localhost:5432/cities
REDIS_URL=redis://localhost:6379/0

# Maximum repos ingested per user, most recently pushed first.
MAX_REPOS_PER_USER=100

# Newest commits fetched per repo for the timeline. Repo totals stay exact regardless.
# Other GitHub client tuning knobs (retries, rate limit reserve, waits) are in app/config.py.
GITHUB_MAX_COMMITS_PER_REPO=5000
